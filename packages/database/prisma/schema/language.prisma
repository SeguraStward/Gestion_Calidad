model Language {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  version      Int                @default(0) @map("__v")
  conversation Int
  writing      Int
  status       String
  evidence     LanguageEvidence[]
  languageName String
  reading      Int
  type         String

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("languages")
}

type LanguageEvidence {
  download String
  fileId   String @map("file_id")
  link     String
  name     String
  type     String
  uri      String
}
