
model Language {
   id           String            @id @default(auto()) @map("_id") @db.ObjectId
   version      Int               @map("__v") @default(0)
   conversation Int               @map("conversation")
   writing      Int               @map("writing")
   status       String            @map("status")
   evidence     LanguageEvidence[] @map("evidence")
   userId       String            @map("user_id") @db.ObjectId
   languageName String            @map("language_name")
   reading      Int               @map("reading")
   type         String            @map("type")

   @@map("languages")
}

type LanguageEvidence {
   download     String
   fileId       String            @map("file_id")
   link         String
   name         String
   type         String
   uri          String
}