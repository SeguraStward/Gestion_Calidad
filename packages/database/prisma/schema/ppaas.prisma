model Ppaa {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  version      Int            @default(0) @map("__v")
  status       String
  evidence     PpaaEvidence[]
  activityDate String
  location     String
  activityName String
  activityType String

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([activityDate])
  @@map("ppaas")
}

type PpaaEvidence {
  download String
  fileId   String
  link     String
  name     String
  type     String
  uri      String
}
