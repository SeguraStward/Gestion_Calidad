// #22
model ProjectNotification {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  // Usuario que creó el oficio
  userId String? @db.ObjectId
  user   User?   @relation("NotificationCreator", fields: [userId], references: [id])

  // Usuario que actualizó
  updatedById String? @db.ObjectId
  updatedBy   User?   @relation("NotificationUpdater", fields: [updatedById], references: [id])

  // Número de oficio
  notificationNumber String?

  // Proyecto asociado
  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])

  // Sesión asociada
  sessionId String      @db.ObjectId
  session   CommSession @relation(fields: [sessionId], references: [id])

  // Datos informativos
  students        String?
  careerName      String?
  commissionName  String?
  coordinatorName String?
  campusName      String?

  // Estado y fechas
  status Status @default(ACTIVE)

  // Relación con entradas de bitácora
  // logEntries ProjectLogEntry[]

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  // updatedBy  String?           @db.ObjectId

  @@index([userId])
  @@index([updatedById])
  @@index([projectId])
  @@index([sessionId])
  @@map("project_notifications")
}
