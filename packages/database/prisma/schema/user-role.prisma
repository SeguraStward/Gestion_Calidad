// #32
model UserRole {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  name        String       @unique
  description String?
  permissions Permission[]

  status Status @default(ACTIVE)

  // Relations
  userIds String[] @db.ObjectId
  users   User[]   @relation("UserRoles", fields: [userIds], references: [id])

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@map("user_roles")
}

type Permission {
  permissionID String           @db.ObjectId
  permissions  PermissionType[]
  scope        PermissionScope? // Define el alcance del permiso
  actions      String[] // Acciones específicas permitidas
}

enum PermissionType {
  CREATE
  READ
  UPDATE
  DELETE
  REPORT // Permiso para generar reportes
}

enum PermissionScope {
  ALL // Acceso total a todos los registros
  OWN // Solo a registros propios
}
