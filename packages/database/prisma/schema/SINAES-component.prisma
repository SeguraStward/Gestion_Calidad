// Component model for quality management categorization
model Component {
  version Int    @default(0) @map("__v")
  id      String @id @default(auto()) @map("_id") @db.ObjectId

  code        String  @unique
  name        String
  description String?
  order       Int
  dimensionId String  @db.ObjectId

  status Status @default(ACTIVE)

  // Relations
  dimension         Dimension                @relation(fields: [dimensionId], references: [id])
  criteria          Criterion[]
  complianceReports SinaesComplianceReport[]

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@map("components")
}
