model AcademicLoad {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  nrc String

  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  academicPeriodId String         @db.ObjectId

  campus   Campus @relation(fields: [campusId], references: [id])
  campusId String @db.ObjectId

  course   Course @relation(fields: [courseId], references: [id])
  courseId String @db.ObjectId

  classroom   Classroom @relation(fields: [classroomId], references: [id])
  classroomId String    @db.ObjectId

  maximumCapacity  Int
  enrolledCapacity Int
  availableSeats   Int

  group   Group  @relation(fields: [groupId], references: [id])
  groupId String @db.ObjectId

  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  scheduleId String   @db.ObjectId

  professor   Professor @relation(fields: [professorId], references: [id])
  professorId String    @db.ObjectId

  date DateTime?

  status            Status
  FinalReport       FinalReport[]
  StudentEnrollment StudentEnrollment[]

  @@index([academicPeriodId])
  @@index([campusId])
  @@index([courseId])
  @@index([professorId])
  @@map("academic_loads")
}
