model final_work {
    id        String                    @id @default(auto()) @map("_id") @db.ObjectId
    version   Int                       @map("__v")@default(0)
    estado    String
    evidence FinalWorkEvidence[]
    date     String?
    idUser String                    @db.ObjectId
    type     String
    title    String

    @@map("final_works")
}

type FinalWorkEvidence {
    download String
    idFile   String
    link     String?
    name     String?
    tipo     String
    uri      String
}
