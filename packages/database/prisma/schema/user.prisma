model User {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  email        UserEmail @unique
  fullName     String
  fullLastName String
  photoUrl     String?   @default("")

  nationalId   String?
  birthDate    DateTime?
  primaryPhone String?
  phoneNumbers UserPhone[]

  province Province?
  canton   String?
  district String?
  address  String?

  professionalTitle String?
  hireDate          DateTime?
  condition         String?

  roles        UserRole[]
  permissions  UserPermission[]
  profileTypes String[]
  status       Status           @default(ACTIVE)

  googleId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professor               Professor?
  intellectualProductions IntellectualProduction[]
  academicBackgrounds     AcademicBackground[]
  enrollments             StudentEnrollment[]
  workExperiences         WorkExperience[]
  finalWorks              FinalWork[]
  userLanguages           UserLanguage[]
  ppaas                   Ppaa[]

  @@index([province, canton, district])
  @@index([fullName, fullLastName])
  @@index([roles])
  @@map("users")
}

type UserEmail {
  email      String
  isVerified Boolean @default(false)
}

type UserPhone {
  number    String?
  isPrimary Boolean @default(false)
}

enum UserPermission {
  EDIT
  DELETE
  ADD
  VIEW
}

enum UserRole {
  ADMIN
  USER
  STUDENT
  PROFESSOR
}

enum Province {
  SAN_JOSE
  ALAJUELA
  CARTAGO
  HEREDIA
  GUANACASTE
  PUNTARENAS
  LIMON
}
