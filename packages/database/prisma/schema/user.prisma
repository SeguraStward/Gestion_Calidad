model User {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  version    Int       @default(0) @map("__v")
  email      UserEmail @unique
  nationalId String?
  canton     String?
  district   String?
  googleId   String?   @unique

  firstName String?
  lastName  String?
  province  Province?
  role      UserRole?

  condition         String?
  address           String?
  status            Status    @default(ACTIVE)
  hireDate          DateTime?
  birthDate         DateTime?
  photoUrl          String?   @default("")
  profileType       String?
  primaryPhone      String?
  professionalTitle String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions  UserPermission[]
  phoneNumbers UserPhone[]

  professor               Professor?
  intellectualProductions IntellectualProduction[]
  academicBackgrounds     AcademicBackground[]
  enrollments             StudentEnrollment[]
  workExperiences         WorkExperience[]
  finalWorks              FinalWork[]
  language                Language[]
  ppaas                   Ppaa[]

  @@index([province, canton, district])
  @@index([firstName, lastName])
  @@index([role])
  @@map("users")
}

type UserEmail {
  email      String
  isVerified Boolean @default(false)
}

type UserPhone {
  number    String?
  isPrimary Boolean @default(false)
}

enum UserPermission {
  EDIT
  DELETE
  ADD
  VIEW
}

enum UserRole {
  ADMIN
  USER
  STUDENT
  PROFESSOR
}

enum Province {
  SAN_JOSE
  ALAJUELA
  CARTAGO
  HEREDIA
  GUANACASTE
  PUNTARENAS
  LIMON
}
