model User {
    id                 String              @id @default(auto()) @map("_id") @db.ObjectId
    version            Int                 @map("__v")@default(0)
    canton             String
    cedula             String
    clave              String
    condicion          String?
    direccion          String
    distrito           String
    edad               String?
    emails             UserEmail[]
    estado             String
    fecha_contratacion String?
    fecha_nacimiento   String?
    foto               String
    nombre             String
    perfil             String?
    provincia          String
    rol                String
    telefono           String?
    telefonos          UserPhone[]
    titulo             String?
    @@map("users")
}



type UserEmail {
    email String
}

type UserPhone {
    telefono String
}
