model FinalWork {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  version  Int        @default(0) @map("__v")
  status   String
  evidence Evidence[]
  date     DateTime?
  type     String
  title    String

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  @@map("final_works")
}
