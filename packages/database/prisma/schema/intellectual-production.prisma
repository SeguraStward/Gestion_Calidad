// #17
model IntellectualProduction {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  category       String
  productionName String
  topic          String

  presentationPlace String
  presentationCount Int

  evidence Evidence[]
  year     Int

  userId String @db.ObjectId

  status Status @default(ACTIVE)

  // Relation
  user User @relation("UserIntellectualProduction", fields: [userId], references: [id])

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@unique([userId, productionName])
  @@map("intellectual_productions")
}
