model IntellectualProduction {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  version           Int     @default(0) @map("__v")
  presentationCount Int
  category          String
  status            String?
  presentationVenue String
  productionName    String
  topic             String
  year              String
  userId            String  @db.ObjectId
  user              User    @relation(fields: [userId], references: [id])

  evidence IntellectualProductionEvidence[]

  @@map("intellectual_productions")
}

type IntellectualProductionEvidence {
  download String
  fileId   String
  link     String
  name     String
  type     String
  uri      String
}
