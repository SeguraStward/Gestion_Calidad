// #5
model Campus {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  code        String  @unique
  name        String?
  description String

  regionalCenterId String @db.ObjectId

  status Status @default(ACTIVE)

  // Relations
  regionalCenter RegionalCenter @relation(fields: [regionalCenterId], references: [id])

  classrooms    Classroom[]
  academicLoads AcademicLoad[]

  // Relations with Journey Time Management - Optimized
  journeyTimeAllocations CampusJourneyTimeAllocation[] @relation("CampusJourneyAllocations")
  professorAssignments   ProfessorAssignment[]         @relation("CampusAssignments")
  repitencias   Repitencia[]   @relation("CampusRepitencias")
  courseReports CourseReport[] @relation("CampusReports")

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@map("campuses")
}
