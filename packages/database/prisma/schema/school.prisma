model School {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  code        String
  description String

  facultyId String  @db.ObjectId
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  status Status

  courses    Course[]
  professors Professor[]

  @@map("schools")
}
