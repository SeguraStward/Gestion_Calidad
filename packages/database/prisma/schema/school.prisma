model School {
    id          String      @id @default(auto()) @map("_id") @db.ObjectId
    version     Int         @default(0) @map("__v")
    code        String
    description String
    status      String
    idFaculty   String      @db.ObjectId
    faculty     Faculty     @relation(fields: [idFaculty], references: [id])
    courses     Course[]
    professors  Professor[]

    @@map("schools")
}
