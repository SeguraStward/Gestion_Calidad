// ProofDocument model for storing actual proof documents
model ProofDocument {
  version Int    @default(0) @map("__v")
  id      String @id @default(auto()) @map("_id") @db.ObjectId

  code                String  @unique // Auto-generated: PREFIX-NUMBER (e.g., CONV-001)
  name                String
  description         String?
  fileUrl             String // Google Drive public URL
  fileName            String
  fileType            String // e.g., "pdf", "docx", "xlsx"
  fileSize            Int? // Size in bytes
  evidenceId          String  @db.ObjectId
  proofDocumentTypeId String  @db.ObjectId

  // Google Drive metadata
  googleDriveFileId         String? // Google Drive file ID
  googleDriveFolderId       String? // Evidence folder ID in Google Drive (legacy + still set)
  googleDriveTypeFolderId   String? // Folder for the document type (e.g. "Convenio/")
  googleDriveUploadFolderId String? // Folder for this specific upload (e.g. "CONV-001/")
  googleDriveVersion        String? // Version tracking for updates

  status Status @default(ACTIVE)

  // Relations
  evidence             QualityEvidence         @relation(fields: [evidenceId], references: [id])
  proofDocumentType    ProofDocumentType       @relation(fields: [proofDocumentTypeId], references: [id])
  careerProofDocuments CareerProofDocument[]   @relation("ProofDocumentToCareers")
  documentHistory      SinaesDocumentHistory[] // Historial de cambios

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@map("proof_documents")
}
