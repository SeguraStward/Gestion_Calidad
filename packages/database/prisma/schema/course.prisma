model Course {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  version        Int            @map("__v") @default(0) // Added version field
  code           String         @unique  
  name           String
  description    String?
  credits        Int
  contactHours   Int
  level          String
  academicLoads AcademicLoad[] 
  school     School         @relation(fields: [schoolId], references: [id])
  schoolId   String         @db.ObjectId
  @@map("courses")
}
