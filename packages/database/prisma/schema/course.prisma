model Course {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  version       Int            @default(0) @map("__v")
  code          String         @unique
  name          String
  level         String
  description   String?
  credits       Int
  status        Status
  contactHours  Int
  academicLoads AcademicLoad[]
  school        School         @relation(fields: [schoolId], references: [id])
  schoolId      String         @db.ObjectId

  @@map("courses")
}
