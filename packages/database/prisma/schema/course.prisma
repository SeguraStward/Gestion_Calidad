// #12
model Course {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  code        String  @unique
  name        String
  description String?

  credits          Int
  level            Int
  contactHours     Int
  independentHours Int?

  // schoolId String  @db.ObjectId
  careerId String? @db.ObjectId

  status Status @default(ACTIVE)

  // Relations
  // school School? @relation(fields: [schoolId], references: [id])
  career Career? @relation(fields: [careerId], references: [id])

  academicLoads AcademicLoad[]

  // Relations with Journey Time Management - Optimized
  meshCourses   CurricularMeshCourse[] @relation("CourseMeshes")
  repitencias   Repitencia[]           @relation("CourseRepitencias")
  courseReports CourseReport[]         @relation("CourseReports")

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@index([careerId])
  @@map("courses")
}
