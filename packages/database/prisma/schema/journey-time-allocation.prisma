// Modelo optimizado para asignación de tiempos de jornada

model AnnualJourneyTimeAllocation {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  // Año al que corresponde la asignación
  year Int @unique

  // Total de tiempos de jornada asignados por la universidad para el año
  totalJourneyTime Float

  // Descripción o notas sobre la asignación
  description String?

  // Estado de la asignación
  status AllocationStatus @default(DRAFT)

  // Relaciones
  campusAllocations CampusJourneyTimeAllocation[] @relation("AnnualCampusAllocations")
  externalProviders ExternalProvider[]            @relation("AnnualExternalProviders")

  // Campos calculados
  totalAllocatedToCampus     Float @default(0)
  totalFromExternalProviders Float @default(0)
  availableJourneyTime       Float @default(0)

  // Campos de auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@map("annual_journey_time_allocations")
}

// Modelo optimizado para asignación por campus
model CampusJourneyTimeAllocation {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  // Relaciones con modelos existentes
  annualAllocationId String @db.ObjectId
  campusId           String @db.ObjectId
  curricularMeshId   String? @db.ObjectId
  academicCycleId    String @db.ObjectId

  annualAllocation AnnualJourneyTimeAllocation @relation("AnnualCampusAllocations", fields: [annualAllocationId], references: [id])
  campus           Campus                      @relation("CampusJourneyAllocations", fields: [campusId], references: [id])
  curricularMesh   CurricularMesh?             @relation("MeshAllocations", fields: [curricularMeshId], references: [id])
  academicCycle    AcademicCycle               @relation("CycleJourneyAllocations", fields: [academicCycleId], references: [id])

  // Tiempo de jornada asignado y calculado
  allocatedJourneyTime    Float
  baseJourneyTimeConsumed Float
  additionalJourneyTime   Float @default(0)
  availableJourneyTime    Float @default(0)

  // Estado de la asignación
  status AllocationStatus @default(DRAFT)

  // Referencia manual para la demo mientras no exista integración completa con mallas
  description String?

  // Relaciones
  professorAssignments  ProfessorAssignment[]  @relation("AllocationAssignments")
  institutionalProjects InstitutionalProject[] @relation("AllocationProjects")
  repitencias           Repitencia[]           @relation("AllocationRepitencias")

  // Campos de auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@unique([annualAllocationId, campusId, curricularMeshId, academicCycleId], name: "unique_campus_allocation")
  @@index([annualAllocationId])
  @@index([campusId])
  @@index([curricularMeshId])
  @@index([academicCycleId])
  @@map("campus_journey_time_allocations")
}
