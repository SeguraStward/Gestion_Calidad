model Schedule {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  version        Int            @map("__v") @default(0) // Added version field
  days           ScheduleDays[]
  startTime      String          
  endTime        String          
  academicLoads AcademicLoad[]
  @@map("schedules")
}


enum ScheduleDays {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}