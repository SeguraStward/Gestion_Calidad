model Ppaa {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  activityName String
  activityType String
  activityDate String
  location     String
  evidence     Evidence[]
  status       String

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([activityDate])
  @@map("ppaas")
}
