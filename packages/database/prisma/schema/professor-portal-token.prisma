model ProfessorPortalToken {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  cedula String
  token  String @unique

  campusId        String @db.ObjectId
  academicCycleId String @db.ObjectId

  expiresAt DateTime
  usedAt    DateTime?

  status ProfessorPortalTokenStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@index([cedula])
  @@index([campusId])
  @@index([academicCycleId])
  @@index([expiresAt])
  @@index([status])
  @@map("professor_portal_tokens")
}

enum ProfessorPortalTokenStatus {
  ACTIVE
  USED
  EXPIRED
}
