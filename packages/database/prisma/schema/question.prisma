// #27
model Question {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  groupId String? @db.ObjectId

  module String?

  question String

  options QuestionOption[]

  responseType ResponseType

  questionVersion String?

  // New fields for step management
  stepNumber  Int? // 5 or 7 for final report steps
  appliesTo   String[] // Report types this question applies to
  description String? // Additional description for the question
  isRequired  Boolean  @default(true)
  order       Int? // Order within the step/group

  status Status @default(ACTIVE)

  // Relations
  group QuestionGroup? @relation(fields: [groupId], references: [id])

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@index([stepNumber, status])
  @@index([groupId, stepNumber])
  @@map("questions")
}

enum ResponseType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTISELECT
}

type QuestionOption {
  category String
  label    String
  value    String
}
