model Question {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  version      Int              @default(0) @map("__v")
  status       String
  groupId      String           @db.ObjectId
  module       String
  options      QuestionOption[]
  question     String
  responseType String

  @@map("questions")
}

type QuestionOption {
  category String
  label    String
  value    String
}

