model Question {
   id             String           @id @default(auto()) @map("_id") @db.ObjectId
   version        Int              @map("__v") @default(0)
   status         String           
   groupId        String           @db.ObjectId
   module         String           
   options        QuestionOption[]  
   question       String            
   responseType   String           

   @@map("questions")
}

type QuestionOption {
   category       String
   label          String
   value          String
}
//NOTE: should group or questiongroup have multiple questions?