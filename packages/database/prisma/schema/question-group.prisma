// #26
model QuestionGroup {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  name          String  @unique
  questionTitle String
  description   String?

  // New fields for step management
  stepNumber Int? // 5 or 7 for final report steps
  appliesTo  String[] // Report types this group applies to
  order      Int? // Order within the step

  status Status @default(ACTIVE)

  // Relations
  questions Question[]

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@index([stepNumber, status])
  @@map("question_groups")
}
