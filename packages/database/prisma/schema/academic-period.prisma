model AcademicPeriod {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  code        String
  description String
  status      Status

  name      String?
  startDate DateTime?
  endDate   DateTime?

  academicLoads AcademicLoad[]

  @@map("academic_periods")
}
