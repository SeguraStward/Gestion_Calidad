// #15
model FinalReport {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v") // used for versioning in this model

  statistics         FinalReportStatistics
  evaluation         FinalReportEvaluation[]
  studentInformation FinalReportStudentInformation

  status FinalReportStatus @default(PENDING)

  // Relations

  professorId String @db.ObjectId
  professor   User   @relation("ProfessorFinalReport", fields: [professorId], references: [id])

  academicLoadId String       @db.ObjectId
  academicLoad   AcademicLoad @relation(fields: [academicLoadId], references: [id])

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  // @@unique([professorId, academicLoadId])
  @@index([status, professorId])
  @@index([academicLoadId])
  @@map("final_reports")
}

enum FinalReportStatus {
  PENDING
  EVALUATED
  ACTIVE
}

type FinalReportStatistics {
  passed        Int
  failed        Int
  dropouts      Int
  totalStudents Int
}

type FinalReportEvaluation {
  questionGroup    String?
  questionId       String
  options          FinalReportEvaluationOptions[]
  otherResponse    String?
  question         String
  response         String?
  multipleResponse String[]
  responseType     String
  stepNumber       Int? // 5, 6, or 7 - to identify which step this evaluation belongs to
}

type FinalReportEvaluationOptions {
  category String?
  label    String?
  value    String?
}

type FinalReportStudentInformation {
  adjustments FinalReportStudentAdjustment[]
  safeguards  FinalReportStudentSafeguard[]
}

type FinalReportStudentAdjustment {
  support     String
  idNumber    String
  name        String
  grade       String
  observation String?
}

type FinalReportStudentSafeguard {
  idNumber    String
  name        String
  grade       String
  observation String?
}
