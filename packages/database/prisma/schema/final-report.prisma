model FinalReport {
  id                 String                        @id @default(auto()) @map("_id") @db.ObjectId
  version            Int                           @default(0) @map("__v")
  loadId             String                        @db.ObjectId
  load               AcademicLoad                  @relation(fields: [loadId], references: [id])
  statistics         FinalReportStatistics
  status             Status
  evaluation         FinalReportEvaluation[]
  studentInformation FinalReportStudentInformation
  professorId        String                        @db.ObjectId

  @@map("final_reports")
}

type FinalReportStatistics {
  passed        Int
  failed        Int
  dropouts      Int
  totalStudents Int
}

type FinalReportEvaluation {
  questionGroup    String
  questionId       String
  options          FinalReportEvaluationOptions[]
  otherResponse    String
  question         String
  response         String
  multipleResponse String[]
  responseType     String
}

type FinalReportEvaluationOptions {
  category String
  label    String
  value    String
}

type FinalReportStudentInformation {
  adjustments FinalReportStudentAdjustment[]
  safeguards  FinalReportStudentSafeguard[]
}

type FinalReportStudentAdjustment {
  support     String
  idNumber    String
  name        String
  grade       String
  observation String
}

type FinalReportStudentSafeguard {
  idNumber    String
  name        String
  grade       String
  observation String
}
