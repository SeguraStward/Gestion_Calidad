model UserLanguage {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  language String
  type     String
  speaking Int
  writing  Int
  reading  Int
  evidence Evidence[]
  status   Status

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("languages")
}
