model AcademicBackground {
  id              String                     @id @default(auto()) @map("_id") @db.ObjectId
  version   Int                              @map("__v")@default(0)
  status          String                      
  evidence        AcademicBackgroundEvidence[]  
  date            String                     
  // Multiple data types found: String: 11.1%, String (ObjectId): 88.9% out of 9 sampled entries
  userId          Json                        
  institution     String                     
  observations    String                      
  degree          String                     

  @@map("academic_backgrounds")
}

type AcademicBackgroundEvidence {
  download    String
  fileId      String  
  link        String?
  name        String?
  type        String
  uri         String
}