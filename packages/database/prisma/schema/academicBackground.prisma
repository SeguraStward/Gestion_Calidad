model AcademicBackground {
  id              String                     @id @default(auto()) @map("_id") @db.ObjectId
  version         Int                        @map("__v") @default(0)
  status          String                      
  evidence        AcademicBackgroundEvidence[]  
  date            String                      
  userId          String                     @db.ObjectId
  user            User                       @relation(fields: [userId], references: [id])
  institution     String                     
  observations    String                     
  degree          String                     

  @@map("academic_backgrounds")
}

type AcademicBackgroundEvidence {
  download    String
  fileId      String  
  link        String?
  name        String?
  type        String
  uri         String
}