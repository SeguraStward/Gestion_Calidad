// #2
model AcademicCycle {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    @default(0) @map("__v")

  code        String  @unique
  name        String
  year        Int
  description String?

  startDate DateTime?
  endDate   DateTime?

  finalMonth Int?
  initMonth  Int?

  status Status @default(ACTIVE)

  // Relations
  academicLoads AcademicLoad[]
  projects      Project[]

  // Relations with Journey Time Management - Optimized
  meshCourses            CurricularMeshCourse[]        @relation("CycleCourses")
  journeyTimeAllocations CampusJourneyTimeAllocation[] @relation("CycleJourneyAllocations")
  professorAssignments   ProfessorAssignment[]         @relation("CycleAssignments")
  repitencias            Repitencia[]                  @relation("CycleRepitencias")

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId
  updatedBy String?  @db.ObjectId

  @@unique([name, year], name: "unique_academic_cycle")
  @@map("academic_cycles")
}
