{
  "name": "una-gc",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "ui": "pnpm --filter @una-gc/ui ui",
    "prisma": "pnpm --filter @una-gc/database db:generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@una-gc/eslint-config": "workspace:*",
    "@una-gc/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.2.5",
    "turbo": "^2.3.0",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  }
}
