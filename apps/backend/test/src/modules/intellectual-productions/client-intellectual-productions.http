#var, use "command >Rest Client: Switch Environment" in search bar of vs code 

@id=1
@userId=1
###

### Get all intellectual-productions 
GET http://localhost:3000/api/v1/intellectual-productions?page=1&limit=10  HTTP/1.1 
Content-Type: application/json 

### Get intellectual-production by ID 
GET http://localhost:3000/api/v1/intellectual-productions/{{id}} HTTP/1.1 
Content-Type: application/json 

### Create a new intellectual-production 
POST http://localhost:3000/api/v1/intellectual-productions HTTP/1.1 
Content-Type: application/json 

{
  "category": "Research Paper",
  "productionName": "Redes Neuronales en Entornos Educativos",
  "topic": "Avances en Aprendizaje Automático",
  "evidence": [
    {
      "fileId": "file_12345",
      "name": "Documento de Investigación",
      "type": "pdf",
      "uri": "/documents/papers/redes_neuronales.pdf",
      "link": "https://example.com/view/redes_neuronales",
      "download": "https://example.com/download/redes_neuronales.pdf"
    },
    {
      "fileId": "file_67890",
      "name": "Presentación en Conferencia",
      "type": "pptx",
      "uri": "/documents/presentations/conferencia_ia.pptx",
      "link": "https://example.com/view/conferencia_ia",
      "download": "https://example.com/download/conferencia_ia.pptx"
    }
  ],
  "year": "2024",
  "presentationPlace": "Conferencia Internacional de IA",
  "presentationCount": 3,
  "userId": "{{userId}}",
  "status": "ACTIVE"
}

### Update an existing intellectual-production 
PUT http://localhost:3000/api/v1/intellectual-productions/{{id}} HTTP/1.1 
Content-Type: application/json 

{
  "category": "Book Chapter",
  "productionName": "Métodos Estadísticos en la Investigación Educativa",
  "topic": "Análisis Avanzado de Datos",
  "year": "2025",
  "presentationPlace": "Conferencia Académica Virtual",
  "presentationCount": 5,
  "userId": "{{userId}}",
  "status": "ACTIVE"
}  

### Delete a intellectual-production 
DELETE http://localhost:3000/api/v1/intellectual-productions/{{id}} HTTP/1.1 
Content-Type: application/json

