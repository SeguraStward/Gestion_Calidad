#var, use command >Rest Client: Switch Environment in search bar of vs code
@id=1
@academicCycleId=1
@campusId=1
@courseId=1
@classroomId=1

@groupId=1
@scheduleId=1
@professorId=1


###

### Get all academic loads
GET http://localhost:3000/api/v1/academic-loads?page=1&limit=10  HTTP/1.1
Content-Type: application/json

###

### Get academic load by ID
GET http://localhost:3000/api/v1/academic-loads/{{id}} HTTP/1.1
Content-Type: application/json

###

### Create a new academic load
POST http://localhost:3000/api/v1/academic-loads HTTP/1.1
Content-Type: application/json

{
  "nrc": "12345",
  "academicCycleId": "{{academicCycleId}}",
  "campusId": "{{campusId}}",
  "courseId": "{{courseId}}",
  "classroomId": "{{classroomId}}",
  "maximumCapacity": 30,
  "enrolledCapacity": 25,
  "availableSeats": 5,
  "groupId": "{{groupId}}",
  "scheduleId": "{{scheduleId}}",
  "professorId": "{{professorId}}",
  "date": "2025-04-19T14:30:00Z",
  "status": "ACTIVE"
}

### Update an existing academic load
PUT http://localhost:3000/api/v1/academic-loads/{{id}} HTTP/1.1
Content-Type: application/json

{
  "nrc": "12345",
  "maximumCapacity": 35,
  "enrolledCapacity": 28,
  "availableSeats": 7,
  "date": "2025-04-20T14:30:00Z",
  "status": "ACTIVE"
}

###

### Delete an academic load
DELETE http://localhost:3000/api/v1/academic-loads/{{id}} HTTP/1.1
Content-Type: application/json