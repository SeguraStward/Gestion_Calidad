#var, use "command >Rest Client: Switch Environment" in search bar of vs code 
@id = 60f7a5c4d5b5e40c8c234567

### Get all academic-loads-groups 
GET http://localhost:3000/api/v1/academic-loads-groups HTTP/1.1 
Content-Type: application/json 

### Get academic-loads-group by ID 
GET http://localhost:3000/api/v1/academic-loads-groups/{{id}} HTTP/1.1 
Content-Type: application/json 

### Create a new academic-loads-group 
POST http://localhost:3000/api/v1/academic-loads-groups HTTP/1.1 
Content-Type: application/json 

{
  "number": "G-001",
  "status": "ACTIVE"
}

### Update an existing academic-loads-group 
PUT http://localhost:3000/api/v1/academic-loads-groups/{{id}} HTTP/1.1 
Content-Type: application/json 

{
  "number": "G-002",
  "status": "INACTIVE"
}

### Delete a academic-loads-group 
DELETE http://localhost:3000/api/v1/academic-loads-groups/{{id}} HTTP/1.1 
Content-Type: application/json

