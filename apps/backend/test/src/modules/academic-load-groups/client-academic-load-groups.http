#var, use "command >Rest Client: Switch Environment" in search bar of vs code 
@id=1
###

### Get all academic-load-groups 
GET http://localhost:3000/api/v1/academic-load-groups?page=1&limit=10 HTTP/1.1 
Content-Type: application/json 

### Get academic-loads-group by ID 
GET http://localhost:3000/api/v1/academic-load-groups/{{id}} HTTP/1.1 
Content-Type: application/json 

### Create a new academic-loads-group 
POST http://localhost:3000/api/v1/academic-load-groups HTTP/1.1 
Content-Type: application/json 

{
  "number": "86",
  "status": "ACTIVE"
}

### Update an existing academic-loads-group 
PUT http://localhost:3000/api/v1/academic-load-groups/{{id}} HTTP/1.1 
Content-Type: application/json 

{
  "number": "86",
  "status": "INACTIVE"
}

### Delete a academic-loads-group 
DELETE http://localhost:3000/api/v1/academic-load-groups/{{id}} HTTP/1.1 
Content-Type: application/json