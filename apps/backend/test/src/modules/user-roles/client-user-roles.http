#var, use "command >Rest Client: Switch Environment" in search bar of vs code
@id=1

###

### Get all user-roles
GET http://localhost:3000/api/v1/user-roles HTTP/1.1
Content-Type: application/json

###

### Get user-role by ID
GET http://localhost:3000/api/v1/user-roles/{{id}} HTTP/1.1
Content-Type: application/json

###

### Create a new user-role
POST http://localhost:3000/api/v1/user-roles HTTP/1.1
Content-Type: application/json

{
  "name": "Administrador",
  "description": "Rol de administrador con acceso total",
  "permissions": [
    {
      "entity": "Usuario",
      "permissions": ["CREATE", "READ", "UPDATE", "DELETE"],
      "scope": "ALL",
      "actions": ["aprobar", "rechazar"]
    },
    {
      "entity": "Proyecto",
      "permissions": ["CREATE", "READ", "UPDATE", "DELETE", "REPORT"],
      "scope": "ALL",
      "actions": []
    }
  ],
  "userIds": [],
  "status": "ACTIVE"
}

###

### Update an existing user-role
PUT http://localhost:3000/api/v1/user-roles/{{id}} HTTP/1.1
Content-Type: application/json

{
  "name": "Editor",
  "description": "Puede editar pero no eliminar contenido",
  "permissions": [
    {
      "entity": "Documento",
      "permissions": ["READ", "UPDATE"],
      "scope": "DEPARTMENT",
      "actions": ["revisar"]
    },
    {
      "entity": "Tarea",
      "permissions": ["CREATE", "READ", "UPDATE"],
      "scope": "OWN",
      "actions": ["asignar", "completar"]
    }
  ],
  "status": "ACTIVE"
}

###

### Delete a user-role
DELETE http://localhost:3000/api/v1/user-roles/{{id}} HTTP/1.1
Content-Type: application/jsons