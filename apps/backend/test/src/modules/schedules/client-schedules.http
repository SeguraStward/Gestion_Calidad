#var, use "command >Rest Client: Switch Environment" in search bar of vs code 

@id = 1 

### Get all schedules 
GET http://localhost:3000/api/v1/schedules HTTP/1.1 
Content-Type: application/json 

### Get schedule by ID 
GET http://localhost:3000/api/v1/schedules/{{id}} HTTP/1.1 
Content-Type: application/json 

### Create a new schedule 
POST http://localhost:3000/api/v1/schedules HTTP/1.1 
Content-Type: application/json 

{
  "days": ["MONDAY", "WEDNESDAY", "FRIDAY"],
  "startTime": "08:00",
  "endTime": "10:00" 
}

### Update an existing schedule 
PUT http://localhost:3000/api/v1/schedules/{{id}} HTTP/1.1 
Content-Type: application/json 

{
  "days": ["TUESDAY", "THURSDAY"],
  "startTime": "13:00",
  "endTime": "15:00",
  "academicLoadIds": ["6073a5c4d5b5e40c8c234569"]
}

### Delete a schedule 
DELETE http://localhost:3000/api/v1/schedules/{{id}} HTTP/1.1 
Content-Type: application/json

