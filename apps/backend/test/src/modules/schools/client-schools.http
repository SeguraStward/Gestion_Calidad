#var, use "command >Rest Client: Switch Environment" in search bar of vs code 
@id = 60f7a5c4d5b5e40c8c234567

### Get all schools
GET http://localhost:3000/api/v1/schools HTTP/1.1
Content-Type: application/json

### Get school by ID
GET http://localhost:3000/api/v1/schools/{{id}} HTTP/1.1
Content-Type: application/json
 
### Create a new school
POST http://localhost:3000/api/v1/schools HTTP/1.1
Content-Type: application/json

{
  "code": "CSSS",
  "description": "School of Phylosophy and Social Sciences",
  "facultyId": "60f7a5c4d5b5e40c8c234568",
  "status": "ACTIVE"
}

### Update a school
PUT http://localhost:3000/api/v1/schools/{{id}} HTTP/1.1
Content-Type: application/json

{
  "code": "CS",
  "description": "Updated School of Computer Science",
  "facultyId": "60f7a5c4d5b5e40c8c234568",
  "status": "ACTIVE"
}

### Delete a school
DELETE http://localhost:3000/api/v1/schools/{{id}} HTTP/1.1
Content-Type: application/json

