#var, use command >Rest Client: Switch Environment in search bar of vs code
@id =1

###

### Get all users
GET http://localhost:3000/api/v1/users HTTP/1.1
Content-Type: application/json

###

### Get user by ID
GET http://localhost:3000/api/v1/users/{{id}} HTTP/1.1
Content-Type: application/json

###

### Create a new user
POST http://localhost:3000/api/v1/users HTTP/1.1
Content-Type: application/json

{
    "email": {
    "email": "john.doe@example.com",
    "isVerified": false
  },
  "fullName": "John",
  "fullLastName": "Doe Smith",
  "photoUrl": "https://example.com/photos/johndoe.jpg",
  "nationalId": "123456789",
  "birthDate": "1990-01-15T00:00:00.000Z",
  "primaryPhone": "88776655",
  "phoneNumbers": [
    {
      "number": "88776655",
      "isPrimary": true
    },
    {
      "number": "22334455",
      "isPrimary": false
    }
  ],
  "province": "SAN_JOSE",
  "canton": "Central",
  "district": "Catedral",
  "address": "100m Norte del Parque Central",
  "professionalTitle": "Ingeniero en Sistemas",
  "hireDate": "2020-03-01T00:00:00.000Z",
  "condition": "Tiempo completo",
  "roles": ["USER", "PROFESSOR"],
  "permissions": ["VIEW", "EDIT"],
  "profileTypes": ["academic", "research"],
  "status": "ACTIVE",
  "googleId": "g-123456789"
}

###

### Update an existing user
PUT http://localhost:3000/api/v1/users/{{id}} HTTP/1.1
Content-Type: application/json

{
  "email": {
    "email": "john.doe.updated@example.com",
    "isVerified": true
  },
  "fullName": "John Updated",
  "fullLastName": "Doe Smith Updated",
  "photoUrl": "https://example.com/photos/johndoe_new.jpg",
  "nationalId": "987654321",
  "birthDate": "1990-01-15T00:00:00.000Z",
  "primaryPhone": "99887766",
  "phoneNumbers": [
    {
      "number": "99887766",
      "isPrimary": true
    },
    {
      "number": "22334455",
      "isPrimary": false
    }
  ],
  "province": "HEREDIA",
  "canton": "Central",
  "district": "Mercedes",
  "address": "200m Este de la UNA",
  "professionalTitle": "Máster en Ciencias de la Computación",
  "hireDate": "2020-03-01T00:00:00.000Z",
  "condition": "Tiempo y medio",
  "roles": ["USER", "PROFESSOR", "ADMIN"],
  "permissions": ["VIEW", "EDIT", "ADD", "DELETE"],
  "profileTypes": ["academic", "research", "administrative"],
  "status": "ACTIVE"
}

###

### Delete a user
DELETE http://localhost:3000/api/v1/users/{{id}} HTTP/1.1
Content-Type: application/json
